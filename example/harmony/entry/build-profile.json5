{
  "apiType": 'stageMode',
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-s",
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ]
    },
    "sourceOption": {
      "workers": [
        './src/main/ets/workers/RNOHWorker.ets'
      ]
    },
  },
  "targets": [
    {
      "name": "default",
    },
    {
      "name": "ohosTest",
    }
  ]
}