{
  "name": "react-native-harmony-tester",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "i": "cd ../ && npm i && npm run pack && cd ./example && npm i",
    "reStart": "npm run install:pkg && npm run codegen && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-nested-scroll && npm run pack:pkg && npm i @react-native-ohos/react-native-nested-scroll@file:../react-native-ohos-react-native-nested-scroll-0.16.0-beta.1.tgz",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "postinstall": "node ./scripts/create-build-profile",
    "fast:pkg": "cd ../ && npm run pack && cd ./example && npm i -f && npx rimraf ../node_modules/metro-runtime/src/polyfills/require.js && npm run dev",
    "webserver": "node webServer/server.js",
    "rport-webserver": "hdc rport tcp:3000 tcp:3000"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "npm:@react-native-oh/react-native-harmony@0.84.1",
    "@react-native-ohos/react-native-nested-scroll": "file:../react-native-ohos-react-native-nested-scroll-0.16.0-beta.1.tgz",
    "@react-native-ohos/react-native-pager-view": "8.0.0-beta.1",
    "@react-navigation/native": "7.1.17",
    "@react-navigation/stack": "7.2.10",
    "@shopify/flash-list": "^1.4.3",
    "express": "^4.21.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-svg": "15.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "^0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@0.84.1",
    "@tsconfig/react-native": "^3.0.0",
    "@types/d3-scale-chromatic": "^3.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "29.7.0",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "3.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "5.5.4"
  },
  "overrides": {
    "@react-native-community/cli": "20.0.0"
  },
  "resolutions": {
    "@react-native-community/cli": "20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}